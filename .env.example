# Required in Docker/Linux.
TESSERACT_CMD=/usr/bin/tesseract
# Windows local example:
# TESSERACT_CMD=D:\HK2_4\DoAn\OCR\tesseract.exe

# Default model path inside the container.
YOLO_MODEL_PATH=/app/models/weights/best.pt

# Optional. Leave empty to disable Gemini validation.
GEMINI_API_KEY=

# Optional request limit.
MAX_UPLOAD_MB=10
